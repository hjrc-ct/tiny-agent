# Run Chroma installation. See debug commands at the end of this file.
kubectl apply -f chroma.yaml

kubectl get pods -n tiny-agent


kubectl port-forward -n tiny-agent svc/chroma 8000:8000

# Test with this api
curl http://localhost:8000/api/v2/heartbeat


