# 3. Download Qwen3-Embedding-0.6B
# Now execute the Ollama CLI inside the Kubernetes pod:
# First get the pod name:
kubectl get pods -n tiny-agent -l app=ollama

kubectl exec -it -n tiny-agent deploy/ollama -- ollama pull qwen3-embedding:0.6b


kubectl exec -it -n tiny-agent deploy/ollama -- ollama list

# Test it with sample invocation
curl -s http://localhost:11434/api/embed \
  -H "Content-Type: application/json" \
  -d '{"model":"qwen3-embedding:0.6b","input":"Camunda 8 runs workflow processes using Zeebe."}'
