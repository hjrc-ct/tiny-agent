#
# tiny-agent-client/
# ├── app.py
# ├── requirements.txt
# └── Dockerfile

# With above directory structure, lets build python client Docker image
# and then deploy it / run it in our target namespace

# Make sure you are in the Python client folder: pwd -> ./tiny-agent-client

# gcloud artifacts repositories create tiny-agent   --repository-format=docker  --location=asia-south2

# gcloud auth configure-docker asia-south2-docker.pkg.dev

# Lets go to python client directory
cd ./tiny-agent-client

docker build -t asia-south2-docker.pkg.dev/c8-labs/tiny-agent/${UNAMESPACE}-python-client:v1 .


# docker push asia-south2-docker.pkg.dev/c8-labs/tiny-agent/${UNAMESPACE}-python-client:v1
docker buildx build \
  --platform linux/amd64,linux/arm64 \
  -t asia-south2-docker.pkg.dev/c8-labs/tiny-agent/${UNAMESPACE}-python-client:v1 \
  --push .

# Lets return to parent directory
cd ..

# Go back to the parent folder and deploy the service: python-client
envsubst '${UNAMESPACE}' < python-client.yaml  | kubectl apply  -f -
# wait until the pod is running. 


kubectl port-forward  -n ${UNAMESPACE}  svc/python-client   8080:8080

# Test the health of python client
curl "http://localhost:8080/health"
# Expected Output: {"status":"ok","collection_count":47}


curl "http://localhost:8080/search?q=What%20is%20Zeebe&n=5"
